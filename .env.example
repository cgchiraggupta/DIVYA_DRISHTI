# Copy this file to .env and fill in your own Supabase project credentials.
# Find these under Supabase Dashboard -> Project Settings -> API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Set to true to preview the app with local sample data.
VITE_DEMO_MODE=false

# Optional testing-only link to nearby glasses on the same Wi-Fi.
# Never commit a real pairing code.
VITE_LOCAL_PAIRING_CODE=

# Prototype only: prefill one fixed pairing code when the speaker is unavailable.
VITE_PROTOTYPE_PAIRING_CODE=

# Sarvam AI TTS (Indian voice for companion alerts). Free-tier key for demo only.
# Do not commit real keys. Prefer a server/edge proxy before public release.
VITE_SARVAM_API_KEY=

# OpenRouteService (geocoding + walking directions for the Navigate feature).
# Free-tier key from https://openrouteservice.org/dev/#/signup. Prototype only --
# do not commit real keys; move to a server/edge proxy before public release.
VITE_ORS_API_KEY=
