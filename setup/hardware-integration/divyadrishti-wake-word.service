[Unit]
Description=Divya Drishti Hindi wake-word listener ("Hey Divya Drishti")
After=multi-user.target divyadrishti-sensing.service
Wants=divyadrishti-sensing.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /home/pi/divyadrishti_wake_word.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
